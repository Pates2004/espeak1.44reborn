<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Vario</AssemblyName>
    <RootNamespace>Vario</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.44.5.30</Version>
    <FileVersion>1.44.5.30</FileVersion>
    <AssemblyVersion>1.44.5.0</AssemblyVersion>
    <Product>Vario for eSpeak</Product>
    <Authors>Pates2004</Authors>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishSelfContained>false</PublishSelfContained>
    <UseAppHost>true</UseAppHost>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vario.Tests" />
  </ItemGroup>
</Project>
