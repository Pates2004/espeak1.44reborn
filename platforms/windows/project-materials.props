<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</ProjectSourceRoot>
    <ProjectSourceName>$([System.IO.Path]::GetFileName('$(ProjectSourceRoot.TrimEnd(`\`))'))</ProjectSourceName>
    <ProjectMaterialsDrive Condition="'$(ProjectMaterialsDrive)' == '' And Exists('D:\')">D:</ProjectMaterialsDrive>
    <ProjectMaterialsDrive Condition="'$(ProjectMaterialsDrive)' == ''">C:</ProjectMaterialsDrive>
    <ProjectMaterialsRoot Condition="'$(ProjectMaterialsRoot)' == ''">$(ProjectMaterialsDrive)\work\Workspace\$(ProjectSourceName)</ProjectMaterialsRoot>
    <ProjectBuildRoot Condition="'$(ProjectBuildRoot)' == ''">$(ProjectMaterialsRoot)\build\</ProjectBuildRoot>
  </PropertyGroup>
</Project>
